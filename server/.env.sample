# [JWT AUTHENTICATION]: JWT Configuration
# Generate a secure random key (minimum 32 characters) for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-secret-key-min-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# [PER-USER STORAGE]: Storage Backend Configuration
# Options: "local", "huggingface", "zenodo", or "all" (for staging to all backends)
STORAGE_BACKEND=zenodo

# Local filesystem storage (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./uploads

# HuggingFace Spaces Configuration (auto-detected via GRADIO_TEMP_DIR, no config needed)
# When deployed on HuggingFace Spaces, GRADIO_TEMP_DIR is automatically set

# Zenodo Configuration (https://zenodo.org/)
# GET YOUR API TOKEN: https://zenodo.org/account/settings/applications/tokens/new
# Required Scopes: deposit:write, deposit:actions
ZENODO_API_TOKEN=your-zenodo-api-token-here

# Set SANDBOX_MODE to true for development/testing (sandbox.zenodo.org)
# Set to false for production uploads (zenodo.org)
ZENODO_SANDBOX_MODE=true
